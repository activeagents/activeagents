#!/bin/bash
# Starts the image's MySQL server unless it is running, and waits until it
# answers on its socket.
set -euo pipefail

if ! mysqladmin --silent ping >/dev/null 2>&1; then
  install -d -o mysql -g mysql -m 0755 /var/run/mysqld
  mysqld --daemonize --user=mysql --pid-file=/var/run/mysqld/mysqld.pid --bind-address=127.0.0.1 \
    --log-error=/var/log/mysql/error.log
fi
for _ in $(seq 1 120); do
  mysqladmin --silent ping >/dev/null 2>&1 && exit 0
  sleep 0.5
done
echo "MySQL did not answer within 60s; see /var/log/mysql/error.log" >&2
exit 1
