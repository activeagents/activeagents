# Production environment variables
# Copy this to terraform.tfvars and fill in your values

project_id = "active-agents-platform"
region     = "us-central1"
image      = "us-central1-docker.pkg.dev/active-agents-platform/activeagents/activeagents:production"

# Sign in with GitHub, once activeagents-production-github-app-client-id and
# -client-secret each have a version. CI applies the default in variables.tf.
# enable_github_sign_in = true
