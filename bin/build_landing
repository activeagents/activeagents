#!/usr/bin/env ruby
# frozen_string_literal: true

# Landing Page Build Script
# Renders docs/index.html from YAML content and ERB templates
#
# Usage: bin/build_landing
#
# Reads:
#   docs/content/landing.yml          — all page content
#   docs/content/templates/*.html.erb — HTML templates
#
# Generates:
#   docs/index.html

require "yaml"
require "erb"
require "cgi"

APP_ROOT = File.expand_path("..", __dir__)
CONTENT_DIR = File.join(APP_ROOT, "docs", "content")
TEMPLATE_DIR = File.join(CONTENT_DIR, "templates")

class LandingBuilder
  attr_reader :data

  def initialize(data)
    @data = data
  end

  def asset_path(path)
    path
  end

  def h(text)
    CGI.escapeHTML(text.to_s)
  end

  def render_markdown(text)
    text.gsub(/`([^`]+)`/, '<code>\1</code>')
  end

  def render_partial(name)
    template_path = File.join(TEMPLATE_DIR, "#{name}.html.erb")
    template = File.read(template_path)
    ERB.new(template, trim_mode: "-").result(binding)
  end

  def build
    render_partial("docs_page")
  end
end

data = YAML.load_file(File.join(CONTENT_DIR, "landing.yml"), permitted_classes: [Symbol])
builder = LandingBuilder.new(data)
html = builder.build

output_path = File.join(APP_ROOT, "docs", "index.html")
File.write(output_path, html)
puts "Built #{output_path}"
