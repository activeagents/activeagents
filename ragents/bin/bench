#!/usr/bin/env ruby
# frozen_string_literal: true

# =============================================================================
# ragents/bin/bench — Interactive benchmark runner for Ragents
#
# Runs all three concurrency strategy benchmarks against a simulated LLM
# provider (or a real one if API keys are present) and outputs structured
# JSON results that can be visualized in the ActiveAgents dashboard at:
#
#   http://localhost:3000/dashboard/benchmarks
#
# Usage:
#   bin/bench                               # simulated provider, 10 requests
#   bin/bench --requests 50                 # increase concurrency load
#   bin/bench --io-ms 500                   # simulate slower LLM (500ms/req)
#   bin/bench --cpu-iters 500000            # heavier CPU parsing simulation
#   bin/bench --provider openai             # use real OpenAI API
#   bin/bench --output /tmp/bench.json      # save results to file
#   bin/bench --post http://localhost:3000  # POST results to ActiveAgents dashboard
#   bin/bench --watch                       # re-run every 30s (live dashboard mode)
#
# One-liner for M1 Pro local development:
#   OPENAI_API_KEY=sk-... bin/bench --requests 20 --post http://localhost:3000 --watch
# =============================================================================

require "optparse"
require "json"
require "time"
require "net/http"
require "uri"
require "etc"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "ragents"

# ---------------------------------------------------------------------------
# CLI Options
# ---------------------------------------------------------------------------
options = {
  requests:   10,
  io_ms:      100,
  cpu_iters:  50_000,
  provider:   "mock",
  output:     nil,
  post_url:   nil,
  watch:      false,
  watch_secs: 30,
  pool_size:  nil,  # auto-detect from CPU count
  async:      false,
  quiet:      false
}

OptionParser.new do |opts|
  opts.banner = <<~BANNER
    Usage: bin/bench [options]

    Benchmarks six concurrency strategies for LLM workloads:
      1. Sequential     — one request at a time (baseline)
      2. Threads        — one Thread per request (unbounded)
      3. Thread Pool    — bounded Thread pool (CPU cores)
      4. Ractors        — one Ractor per request (true parallelism)
      5. Ractor Pool    — bounded Ractor pool (CPU cores)
      6. Async Fibers   — cooperative scheduling (requires --async flag)

    Results are output as JSON and can be posted to the ActiveAgents
    dashboard for visualization.

  BANNER

  opts.on("-n", "--requests N", Integer, "Number of concurrent requests (default: #{options[:requests]})") { |v| options[:requests] = v }
  opts.on("--io-ms MS", Integer, "Simulated LLM I/O latency in ms (default: #{options[:io_ms]})") { |v| options[:io_ms] = v }
  opts.on("--cpu-iters N", Integer, "CPU work iterations per response (default: #{options[:cpu_iters]})") { |v| options[:cpu_iters] = v }
  opts.on("--provider PROVIDER", "Provider: mock, realistic, openai, anthropic (default: mock)") { |v| options[:provider] = v }
  opts.on("--median-latency MS", Integer, "Realistic provider: median latency in ms (default: 3000)") { |v| options[:median_latency] = v }
  opts.on("--latency-sigma N", Float, "Realistic provider: log-normal sigma (default: 0.8)") { |v| options[:latency_sigma] = v }
  opts.on("--pool-size N", Integer, "Ractor pool size (default: CPU count)") { |v| options[:pool_size] = v }
  opts.on("--pool-scaling", "Run pool scaling analysis (1, 2, cores/2, cores, cores*2, N)") { options[:pool_scaling] = true }
  opts.on("--output FILE", "Save JSON results to file") { |v| options[:output] = v }
  opts.on("--post URL", "POST JSON results to this URL (e.g. http://localhost:3000)") { |v| options[:post_url] = v }
  opts.on("--watch", "Re-run benchmark every --watch-secs seconds") { options[:watch] = true }
  opts.on("--watch-secs N", Integer, "Seconds between watch runs (default: #{options[:watch_secs]})") { |v| options[:watch_secs] = v }
  opts.on("--async", "Include Async fiber strategy (requires 'async' gem)") { options[:async] = true }
  opts.on("-q", "--quiet", "Suppress progress output (JSON only)") { options[:quiet] = true }
  opts.on("-h", "--help") { puts opts; exit }
end.parse!

# ---------------------------------------------------------------------------
# Setup
# ---------------------------------------------------------------------------
N         = options[:requests]
IO_MS     = options[:io_ms]
CPU_ITERS = options[:cpu_iters]
POOL_SIZE = options[:pool_size] || [ (Etc.nprocessors rescue 4), N ].min

def log(msg, quiet: false)
  $stderr.puts msg unless quiet
end

provider_class, provider_opts = case options[:provider]
when "openai"
  [ Ragents::Providers::OpenAIProvider, { api_key: ENV.fetch("OPENAI_API_KEY", "") } ]
when "anthropic"
  [ Ragents::Providers::AnthropicProvider, { api_key: ENV.fetch("ANTHROPIC_API_KEY", "") } ]
when "realistic"
  # Realistic LLM simulator with variable latency (1-30s), variable tokens, log-normal distribution
  [ Ragents::Providers::RealisticLLMProvider, {
    median_latency_ms: options[:median_latency] || 3000,
    latency_sigma: options[:latency_sigma] || 0.8,
    token_rate_range: 30..100,
    response_length_range: 50..500,
    cpu_work_per_token: 100
  } ]
else
  # Fast simulated provider for quick testing (Ractor-safe)
  [ Ragents::Providers::SimulatedProvider, { io_ms: IO_MS, cpu_iterations: CPU_ITERS } ]
end

INPUTS      = N.times.map { |i| "Request #{i + 1}: Explain #{%w[Ractors fibers threads async parallelism][i % 5]} in Ruby." }.freeze
SYSTEM      = "You are a concise Ruby expert."
RUN_STARTED = Time.now.iso8601

log("", quiet: options[:quiet])
log("╔══════════════════════════════════════════════════════════════════════╗", quiet: options[:quiet])
log("║          Ragents Benchmark — Concurrency Strategy Comparison         ║", quiet: options[:quiet])
log("╚══════════════════════════════════════════════════════════════════════╝", quiet: options[:quiet])
log("  Provider : #{options[:provider]}  |  N=#{N}  |  IO=#{IO_MS}ms  |  CPU=#{CPU_ITERS} iters  |  Pool=#{POOL_SIZE}", quiet: options[:quiet])
log("  Hardware : #{Etc.respond_to?(:nprocessors) ? "#{Etc.nprocessors} CPU cores" : "unknown cores"}  |  Ruby #{RUBY_VERSION}  |  #{RbConfig::CONFIG["host_cpu"]}", quiet: options[:quiet])
log("", quiet: options[:quiet])

def run_agent(provider_class, provider_opts, system, input)
  agent = Ragents::Ractor::AgentRactor.new(
    provider_class: provider_class,
    provider_opts: provider_opts,
    system_prompt: system
  )
  start = Process.clock_gettime(Process::CLOCK_MONOTONIC, :millisecond)
  result = agent.run(input)
  elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC, :millisecond) - start
  { result: result, duration_ms: elapsed }
rescue => e
  { error: e.message, duration_ms: 0 }
end

def bench_strategy(name, n, quiet:)
  log("  ▶ #{name} ...", quiet: quiet)
  wall_start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  results    = yield
  wall_ms    = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - wall_start) * 1000).round(1)

  durations  = results.map { |r| r[:duration_ms] }
  errors     = results.count { |r| r[:error] }
  tokens_in  = results.sum { |r| r[:result]&.assistant_message&.input_tokens.to_i }
  tokens_out = results.sum { |r| r[:result]&.assistant_message&.output_tokens.to_i }

  stats = {
    name:          name,
    n_requests:    n,
    wall_time_ms:  wall_ms,
    throughput:    (n / (wall_ms / 1000.0)).round(2),
    avg_latency_ms: durations.sum.to_f / durations.size,
    min_latency_ms: durations.min,
    max_latency_ms: durations.max,
    p50_latency_ms: percentile(durations, 50),
    p95_latency_ms: percentile(durations, 95),
    errors:        errors,
    total_input_tokens: tokens_in,
    total_output_tokens: tokens_out
  }

  log("    ✓ #{wall_ms}ms  |  #{stats[:throughput]} req/s  |  p95=#{stats[:p95_latency_ms]}ms  |  errors=#{errors}", quiet: quiet)
  stats
end

def percentile(arr, pct)
  sorted = arr.sort
  idx = ((pct / 100.0) * (sorted.size - 1)).round
  sorted[idx] || 0
end

# ---------------------------------------------------------------------------
# Main benchmark loop
# ---------------------------------------------------------------------------
def run_benchmarks(provider_class, provider_opts, n, pool_size, system, inputs, options)
  strategies = []

  # 1. Sequential
  strategies << bench_strategy("Sequential", n, quiet: options[:quiet]) do
    inputs.map { |input| run_agent(provider_class, provider_opts, system, input) }
  end

  sequential_ms = strategies.first[:wall_time_ms]

  # 2. Threads (unbounded - one thread per request)
  strategies << bench_strategy("Threads (N=#{n})", n, quiet: options[:quiet]) do
    threads = inputs.map { |input| Thread.new { run_agent(provider_class, provider_opts, system, input) } }
    threads.map(&:value)
  end

  # 3. Thread Pool (bounded by CPU cores - production-style executor)
  strategies << bench_strategy("Thread Pool (size=#{pool_size})", n, quiet: options[:quiet]) do
    require "thread"
    results = Array.new(n)
    queue = Queue.new
    inputs.each_with_index { |input, idx| queue << [input, idx] }
    pool_size.times { queue << nil }  # Poison pills

    workers = pool_size.times.map do
      Thread.new do
        while (item = queue.pop)
          input, idx = item
          results[idx] = run_agent(provider_class, provider_opts, system, input)
        end
      end
    end
    workers.each(&:join)
    results
  end

  # 4. Ractors (pool = N, unbounded - one Ractor per request)
  strategies << bench_strategy("Ractors (N=#{n})", n, quiet: options[:quiet]) do
    pool = Ragents::Ractor::AgentPool.new(
      size: n,
      provider_class: provider_class,
      provider_opts: provider_opts,
      system_prompt: system
    )
    results = pool.process(inputs)
    results.map.with_index do |r, i|
      r.is_a?(Ragents::Ractor::FailedResult) ? { error: r.content, duration_ms: 0 } : { result: r, duration_ms: 0 }
    end
  end

  # 5. Ractor Pool (bounded by CPU cores)
  strategies << bench_strategy("Ractor Pool (size=#{pool_size})", n, quiet: options[:quiet]) do
    pool = Ragents::Ractor::AgentPool.new(
      size: pool_size,
      provider_class: provider_class,
      provider_opts: provider_opts,
      system_prompt: system
    )
    results = pool.process(inputs)
    results.map do |r|
      r.is_a?(Ragents::Ractor::FailedResult) ? { error: r.content, duration_ms: 0 } : { result: r, duration_ms: 0 }
    end
  end

  # 6. Async Fibers (optional) - bypasses Ractors for fair comparison
  # Async fibers excel at I/O concurrency with cooperative scheduling.
  # This strategy simulates what Falcon + RubyLLM would achieve.
  if options[:async]
    begin
      require "async"

      strategies << bench_strategy("Async Fibers (N=#{n})", n, quiet: options[:quiet]) do
        results = Array.new(n)
        # Use AsyncSimulatedProvider which properly yields to fiber scheduler
        # For mock provider, use AsyncSimulatedProvider; for real providers, use the original
        async_provider = if provider_class == Ragents::Providers::SimulatedProvider
          Ragents::Providers::AsyncSimulatedProvider.new(**provider_opts)
        else
          provider_class.new(**provider_opts)
        end

        Async do |task|
          # Spawn N concurrent fibers
          tasks = inputs.each_with_index.map do |input, idx|
            task.async do
              start = Process.clock_gettime(Process::CLOCK_MONOTONIC, :millisecond)

              # Direct provider call - AsyncSimulatedProvider uses Async::Task.current.sleep
              messages = [
                { role: "system", content: system },
                { role: "user", content: input }
              ]

              gen_result = async_provider.chat(messages: messages)

              elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC, :millisecond) - start
              results[idx] = {
                result: Ragents::Ractor::RunResult.new(
                  assistant_message: Ragents::AssistantMessage.new(
                    content: gen_result.content,
                    input_tokens: gen_result.input_tokens,
                    output_tokens: gen_result.output_tokens,
                    model: gen_result.model
                  ),
                  context_snapshot: [].freeze
                ),
                duration_ms: elapsed
              }
            end
          end
          tasks.map(&:wait)
        end
        results
      end
    rescue LoadError
      log("  ⚠ async gem not available — skipping Async strategy", quiet: options[:quiet])
    end
  end

  # Add speedup ratios relative to sequential
  strategies.each do |s|
    s[:speedup_vs_sequential] = (sequential_ms / s[:wall_time_ms]).round(2)
  end

  strategies
end

# ---------------------------------------------------------------------------
# Pool Scaling Analysis - for sandbox resource optimization
# Uses direct provider calls (no Ractors) to avoid Ruby 4.0 segfaults
# ---------------------------------------------------------------------------
def run_pool_scaling(provider_class, provider_opts, n, cores, system, inputs, options)
  log("\n  ═══════════════════════════════════════════════════════════════════", quiet: options[:quiet])
  log("  Pool Scaling Analysis — Finding optimal executor count for sandbox", quiet: options[:quiet])
  log("  ═══════════════════════════════════════════════════════════════════", quiet: options[:quiet])
  log("  N=#{n} requests  |  Cores=#{cores}", quiet: options[:quiet])
  log("", quiet: options[:quiet])

  pool_sizes = [1, 2, [cores / 2, 1].max, cores, cores * 2, n].uniq.sort
  scaling_results = []

  pool_sizes.each do |pool_size|
    next if pool_size < 1

    start = Process.clock_gettime(Process::CLOCK_MONOTONIC)

    require "thread"
    results = Array.new(n)
    queue = Queue.new
    inputs.each_with_index { |input, idx| queue << [input, idx] }
    pool_size.times { queue << nil }

    # Direct provider calls (thread-safe, no Ractor overhead)
    workers = pool_size.times.map do
      Thread.new do
        # Each thread gets its own provider instance
        provider = provider_class.new(**provider_opts)
        while (item = queue.pop)
          input, idx = item
          messages = [
            { role: "system", content: system },
            { role: "user", content: input }
          ]
          results[idx] = provider.chat(messages: messages)
        end
      end
    end
    workers.each(&:join)

    wall_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - start) * 1000).round(1)
    throughput = (n / (wall_ms / 1000.0)).round(1)

    note = case pool_size
           when 1 then "sequential"
           when cores / 2 then "half cores"
           when cores then "= cores"
           when cores * 2 then "2x cores"
           when n then "= requests"
           else ""
           end

    scaling_results << {
      pool_size: pool_size,
      wall_time_ms: wall_ms,
      throughput: throughput,
      note: note
    }

    log("  Pool=%2d → %7.1fms | %6.1f req/s | %s" % [pool_size, wall_ms, throughput, note], quiet: options[:quiet])
  end

  # Find optimal (best throughput)
  optimal = scaling_results.max_by { |r| r[:throughput] }
  log("", quiet: options[:quiet])
  log("  Optimal pool size: #{optimal[:pool_size]} (#{optimal[:throughput]} req/s)", quiet: options[:quiet])

  scaling_results
end

# ---------------------------------------------------------------------------
# Run once or in watch loop
# ---------------------------------------------------------------------------
require "etc"

loop do
  run_at = Time.now.iso8601
  log("\n  Started: #{run_at}", quiet: options[:quiet])

  strategies = run_benchmarks(
    provider_class, provider_opts, N, POOL_SIZE, SYSTEM, INPUTS, options
  )

  # Pool scaling analysis (optional)
  pool_scaling = nil
  if options[:pool_scaling]
    pool_scaling = run_pool_scaling(
      provider_class, provider_opts, N, POOL_SIZE, SYSTEM, INPUTS, options
    )
  end

  # Hardware context
  hardware = {
    ruby_version:    RUBY_VERSION,
    platform:        RUBY_PLATFORM,
    cpu_cores:       (Etc.nprocessors rescue nil),
    cpu_model:       RbConfig::CONFIG["host_cpu"]
  }

  config = {
    n_requests:    N,
    io_latency_ms: IO_MS,
    cpu_iterations: CPU_ITERS,
    pool_size:     POOL_SIZE,
    provider:      options[:provider]
  }

  output = {
    run_at:      run_at,
    hardware:    hardware,
    config:      config,
    strategies:  strategies,
    winner: strategies.min_by { |s| s[:wall_time_ms] }&.slice(:name, :throughput, :wall_time_ms)
  }

  # Add pool scaling results if available
  if pool_scaling
    output[:pool_scaling] = pool_scaling
    optimal = pool_scaling.max_by { |r| r[:throughput] }
    output[:optimal_pool_size] = optimal[:pool_size] if optimal
  end

  json = JSON.pretty_generate(output)

  # Print JSON to stdout (always)
  puts json

  # Optionally save to file
  if options[:output]
    File.write(options[:output], json)
    log("  💾 Saved to #{options[:output]}", quiet: options[:quiet])
  end

  # Optionally POST to ActiveAgents dashboard
  if options[:post_url]
    begin
      uri = URI.parse("#{options[:post_url].chomp("/")}/api/benchmarks")
      http = Net::HTTP.new(uri.host, uri.port)
      req  = Net::HTTP::Post.new(uri)
      req["Content-Type"] = "application/json"
      req.body = JSON.generate(output)
      res = http.request(req)
      log("  📊 Posted to dashboard → #{res.code}", quiet: options[:quiet])
    rescue => e
      log("  ⚠ Failed to post to dashboard: #{e.message}", quiet: options[:quiet])
    end
  end

  break unless options[:watch]

  log("\n  ⏱ Next run in #{options[:watch_secs]}s (Ctrl+C to stop)...", quiet: options[:quiet])
  sleep options[:watch_secs]
end
