<div class="pilot-narrow">
  <p class="pilot-eyebrow">Your private pilot invitation</p>
  <h1>Welcome to <%= @invitation.workspace_name %></h1>
  <p class="pilot-muted">Accept as the workspace owner using <strong><%= @invitation.email_address %></strong>.</p>
  <div class="pilot-card">
    <h2>Pro is included during your pilot</h2>
    <p>No payment method is required. Accepting creates no paid subscription or automatic future charge.</p>
    <p>Review on <strong><%= @invitation.review_on %></strong>. This is a review, not an automatic expiration or charge.</p>
    <% if @invitation.grant_expires_at %>
      <p>Complimentary access expires on <strong><%= @invitation.grant_expires_at.to_date %></strong>.</p>
    <% end %>
    <% if Current.user && Current.user.email_address != @invitation.email_address %>
      <p>You're signed in as a different user. Sign out, then reopen this invitation and sign in with the invited email.</p>
      <%= button_to "Sign out", session_path, method: :delete %>
    <% elsif @existing_user && !Current.user %>
      <p>You already have an account. Sign in to accept this invitation with your existing password.</p>
      <%= link_to "Sign in to accept", new_session_path, class: "pilot-button" %>
    <% else %>
      <%= form_with url: workspace_invitation_path do |form| %>
        <%= hidden_field_tag :token, params[:token] %>
        <% unless @existing_user %>
          <%= form.label :password, "Create your password" %>
          <%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password" %>
          <%= form.label :password_confirmation, "Confirm your password" %>
          <%= form.password_field :password_confirmation, required: true, minlength: 8, autocomplete: "new-password" %>
        <% end %>
        <%= form.submit "Accept invitation and open workspace" %>
      <% end %>
    <% end %>
  </div>
  <p class="pilot-muted">You remain in control of your provider credentials. This invitation does not subscribe you to marketing emails.</p>
  <p><small>If complimentary access ends, a paid subscription continues unchanged; otherwise Free limits apply. The 14-day trace retention window continues for 14 days after access ends, before Free's 3-day window applies. We'll send a notice when access changes.</small></p>
</div>
