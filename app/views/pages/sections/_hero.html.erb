<section>
  <div class="heading hero centered">
    <h1 class="balanced">
      <span class="color-accent">Active Agent</span><br />
      Build AI in Rails
    </h1>
    <p class="paragraph l secondary balanced">
      Agents are Controllers. Ship AI the Rails way.
    </p>
    <div class="button-group margin-paragraph centered">
      <%= link_to "Getting Started", "https://docs.activeagents.ai/getting-started", class: "button primary" %>
      <%= link_to "Docs", "https://docs.activeagents.ai", class: "button tertiary" %>
      <%= link_to "GitHub", "https://github.com/activeagents/activeagent", class: "button tertiary" %>
    </div>
  </div>

  <!-- Agent Builder Preview -->
  <div class="agent-builder-hero" data-controller="agent-builder">
    <div class="agent-preview-container">
      <!-- MCPs floating above -->
      <div class="agent-mcps" data-agent-builder-target="mcps"></div>

      <!-- Base Logo -->
      <div class="logo-container hero-logo">
        <%= inline_svg("activeagent-hero.svg") %>
      </div>

      <!-- Tools below -->
      <div class="agent-tools" data-agent-builder-target="tools"></div>

      <!-- Speech bubbles for translation -->
      <div class="agent-speech-left" data-agent-builder-target="speechLeft" style="display: none;">Hello</div>
      <div class="agent-speech-right" data-agent-builder-target="speechRight" style="display: none;">Hola</div>
    </div>

    <!-- Quick Presets -->
    <div class="agent-presets">
      <button class="preset-btn active" data-action="click->agent-builder#selectPreset" data-preset="claude-code">
        <span class="preset-icon">💻</span>
        <span class="preset-label">Claude Code</span>
      </button>
      <button class="preset-btn" data-action="click->agent-builder#selectPreset" data-preset="web-scraper">
        <span class="preset-icon">🎭</span>
        <span class="preset-label">Web Scraper</span>
      </button>
      <button class="preset-btn" data-action="click->agent-builder#selectPreset" data-preset="research">
        <span class="preset-icon">🔍</span>
        <span class="preset-label">Research</span>
      </button>
      <button class="preset-btn" data-action="click->agent-builder#selectPreset" data-preset="polyglot">
        <span class="preset-icon">🌍</span>
        <span class="preset-label">Polyglot</span>
      </button>
      <button class="preset-btn" data-action="click->agent-builder#selectPreset" data-preset="data-analyst">
        <span class="preset-icon">🗄️</span>
        <span class="preset-label">Data Analyst</span>
      </button>
      <button class="preset-btn" data-action="click->agent-builder#selectPreset" data-preset="devops">
        <span class="preset-icon">🐙</span>
        <span class="preset-label">DevOps Bot</span>
      </button>
    </div>

    <!-- Config Display -->
    <div class="agent-config" data-agent-builder-target="config">
      <span class="config-mcps"><strong>MCPs:</strong> <span data-agent-builder-target="configMcps" data-config="mcps">📁 Filesystem, 🐙 GitHub</span></span>
      <span class="config-tools"><strong>Tools:</strong> <span data-agent-builder-target="configTools" data-config="tools">💻 Terminal, ✏️ Edit, 🔍 Search</span></span>
    </div>
  </div>

  <a href="#features" class="scroll-indicator">
    <span>See what's included</span>
    <i class="fa-solid fa-chevron-down chevron"></i>
  </a>
</section>
