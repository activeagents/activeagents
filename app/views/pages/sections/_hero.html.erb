<%# demo_mode is set when loaded in an iframe to prevent infinite recursion %>
<% demo_mode ||= false %>

<section>
  <div class="heading hero centered">
    <h1 class="balanced">
      <span class="color-accent">Active Agent</span><br />
      Build AI in Rails
    </h1>
    <p class="paragraph l secondary balanced">
      Production observability for Rails AI agents — traces, evaluations,
      costs, and team workspaces, built on the open-source
      <%= link_to "Active Agent framework", "https://activeagent.dev" %>.
      Point your telemetry at us and ship.
    </p>
    <div class="button-group margin-paragraph centered">
      <%= link_to "Start Free", "/registration/new", class: "button primary" %>
      <%= link_to "Open Source", "https://activeagent.dev", class: "button tertiary" %>
    </div>
  </div>

  <% unless demo_mode %>
  <!-- Session Replay Hero - Real Lander Demo -->
  <div class="session-replay-hero"
       data-controller="session-replay"
       data-session-replay-handoff-enabled-value="true"
       data-session-replay-handoff-step-value="4"
       data-session-replay-demo-mode-value="iframe"
       data-session-replay-lander-url-value="<%= request.base_url %>">

    <!-- Browser + Sidebar Row -->
    <div class="session-replay-hero-main">
      <div class="replay-browser-hero">
      <div class="browser-chrome">
        <div class="browser-dots">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        </div>
        <div class="browser-address">
          <i class="fa-solid fa-lock"></i>
          <span class="address-text" data-session-replay-target="addressBar">activeagents.ai</span>
        </div>
        <div class="cassette-badge" data-session-replay-target="cassetteBadge">
          <i class="fa-solid fa-circle recording"></i>
          <span>REC</span>
        </div>
      </div>

      <div class="browser-viewport-hero"
           data-session-replay-target="viewport"
           data-action="mouseenter->session-replay#pauseOnHover mouseleave->session-replay#resumeOnLeave">

        <%# Iframe showing the real lander (scaled down) %>
        <div class="lander-iframe-container" data-session-replay-target="iframeContainer">
          <iframe
            src="<%= request.base_url %>/?demo_mode=true"
            data-session-replay-target="landerIframe"
            class="lander-iframe"
            sandbox="allow-same-origin allow-scripts allow-forms"
            loading="lazy"
            title="Active Agent Lander Preview"></iframe>
        </div>

        <%# Agent Cursor (overlaid on iframe) %>
        <div class="agent-cursor" data-session-replay-target="cursor">
          <svg class="cursor-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M4 4l16 8-7 2-2 7z"/>
          </svg>
          <span class="cursor-label">Agent</span>
        </div>

        <%# Handoff Overlay %>
        <div class="handoff-overlay" data-session-replay-target="handoffOverlay" style="display: none;">
          <div class="handoff-prompt">
            <div class="handoff-icon">
              <i class="fa-solid fa-hand"></i>
            </div>
            <h3>Your turn!</h3>
            <p>Take over and sign up for free</p>
            <button class="handoff-btn" data-action="click->session-replay#takeOverSignup">
              <i class="fa-solid fa-hand-pointer"></i> Take Over
            </button>
            <p class="handoff-hint">You'll control the demo above</p>
          </div>
        </div>
      </div>
    </div>

    <div class="replay-sidebar-hero">
      <div class="sidebar-header">
        <span class="cassette-icon"><i class="fa-solid fa-tape"></i></span>
        <span class="cassette-name">signup_demo.vcr</span>
      </div>
      <div class="action-list" data-session-replay-target="actionList">
        <%# Actions populated by Stimulus controller %>
      </div>

      <%# Trace Log %>
      <div class="trace-log" data-session-replay-target="traceLog" style="display: none;">
        <div class="trace-log-header">
          <i class="fa-solid fa-wave-square"></i> Trace Log
        </div>
        <div class="trace-entries"></div>
      </div>
    </div>
    </div><!-- /.session-replay-hero-main -->

    <div class="replay-controls-hero">
      <div class="replay-timeline"
           data-session-replay-target="timeline"
           data-action="click->session-replay#seekTimeline">
        <div class="timeline-track">
          <div class="timeline-progress" data-session-replay-target="timelineProgress" style="width: 0%;"></div>
          <div class="timeline-snapshots">
            <span class="snapshot-marker" style="left: 5%;" title="Page load"
                  data-action="click->session-replay#jumpToSnapshot" data-step="0"><i class="fa-solid fa-camera"></i></span>
            <span class="snapshot-marker" style="left: 50%;" title="Newsletter section"
                  data-action="click->session-replay#jumpToSnapshot" data-step="3"><i class="fa-solid fa-camera"></i></span>
            <span class="snapshot-marker pending" style="left: 95%;" title="Subscribed"
                  data-action="click->session-replay#jumpToSnapshot" data-step="5"><i class="fa-solid fa-camera"></i></span>
          </div>
          <div class="timeline-playhead" data-session-replay-target="playhead" style="left: 0%;"></div>
        </div>
      </div>
      <div class="replay-buttons">
        <button class="replay-btn" data-action="click->session-replay#stepBackward" title="Previous step">
          <i class="fa-solid fa-backward-step"></i>
        </button>
        <button class="replay-btn play-btn" data-session-replay-target="playPauseBtn" data-action="click->session-replay#togglePlayPause" title="Play/Pause">
          <i class="fa-solid fa-pause" data-session-replay-target="playPauseIcon"></i>
        </button>
        <button class="replay-btn" data-action="click->session-replay#stepForward" title="Next step">
          <i class="fa-solid fa-forward-step"></i>
        </button>
        <button class="replay-btn speed-btn" data-session-replay-target="speedBtn" data-action="click->session-replay#cycleSpeed" title="Playback speed">
          <span data-session-replay-target="speedDisplay">1x</span>
        </button>
        <button class="replay-btn restart-btn" data-action="click->session-replay#restart" title="Restart">
          <i class="fa-solid fa-rotate-left"></i>
        </button>
        <span class="replay-time" data-session-replay-target="stepCounter">Step 1/6</span>
      </div>
    </div>
  </div>
  <% end %><%# unless demo_mode %>

  <a href="#features" class="scroll-indicator">
    <span>See what's included</span>
    <i class="fa-solid fa-chevron-down chevron"></i>
  </a>
</section>
