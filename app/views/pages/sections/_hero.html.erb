<section>
  <div class="heading hero centered">
    <h1 class="balanced">
      <span class="color-accent">Active Agent</span><br />
      Build AI in Rails
    </h1>
    <p class="paragraph l secondary balanced">
      Agents are Controllers. Ship AI the Rails way.
    </p>
    <div class="button-group margin-paragraph centered">
      <%= link_to "Getting Started", "https://docs.activeagents.ai/getting-started", class: "button primary" %>
      <%= link_to "Docs", "https://docs.activeagents.ai", class: "button tertiary" %>
      <%= link_to "GitHub", "https://github.com/activeagents/activeagent", class: "button tertiary" %>
    </div>
  </div>

  <!-- Agent Builder Preview -->
  <div class="agent-builder-hero" data-controller="agent-builder">
    <div class="agent-preview-container">
      <!-- Instructions pinned to hat like a brooch -->
      <div class="agent-instructions-badge" data-agent-builder-target="instructions"></div>

      <!-- Base Logo -->
      <div class="logo-container hero-logo">
        <%= inline_svg("activeagent-hero.svg") %>
      </div>

      <!-- CLI Tools (left hand) -->
      <div class="agent-tools-left" data-agent-builder-target="toolsLeft"></div>

      <!-- MCP Services (right hand) -->
      <div class="agent-tools-right" data-agent-builder-target="toolsRight"></div>

      <!-- Speech bubbles for translation -->
      <div class="agent-speech-left" data-agent-builder-target="speechLeft" style="display: none;">Hello</div>
      <div class="agent-speech-right" data-agent-builder-target="speechRight" style="display: none;">Hola</div>
    </div>

    <!-- Quick Presets -->
    <div class="agent-presets">
      <button class="preset-btn active" data-action="click->agent-builder#selectPreset" data-preset="claude-code">
        <span class="preset-icon">💻</span>
        <span class="preset-label">Claude Code</span>
      </button>
      <button class="preset-btn" data-action="click->agent-builder#selectPreset" data-preset="web-scraper">
        <span class="preset-icon">🎭</span>
        <span class="preset-label">Web Scraper</span>
      </button>
      <button class="preset-btn" data-action="click->agent-builder#selectPreset" data-preset="research">
        <span class="preset-icon">🔍</span>
        <span class="preset-label">Research</span>
      </button>
      <button class="preset-btn" data-action="click->agent-builder#selectPreset" data-preset="polyglot">
        <span class="preset-icon">🌍</span>
        <span class="preset-label">Polyglot</span>
      </button>
      <button class="preset-btn" data-action="click->agent-builder#selectPreset" data-preset="data-analyst">
        <span class="preset-icon">🗄️</span>
        <span class="preset-label">Data Analyst</span>
      </button>
      <button class="preset-btn" data-action="click->agent-builder#selectPreset" data-preset="devops">
        <span class="preset-icon">🐙</span>
        <span class="preset-label">DevOps Bot</span>
      </button>
    </div>

    <!-- Multi-Select Pickers -->
    <div class="agent-selectors">
      <!-- Instructions Selector (system/developer messages) -->
      <div class="selector-group">
        <span class="selector-label"><strong>Instructions:</strong></span>
        <div class="selector-chips" data-agent-builder-target="instructionChips">
          <button class="chip-btn selected" data-action="click->agent-builder#toggleInstruction" data-instruction="github">
            <span class="chip-icon">🐙</span>
            <span class="chip-label">GitHub</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleInstruction" data-instruction="ruby">
            <span class="chip-icon">💎</span>
            <span class="chip-label">Ruby</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleInstruction" data-instruction="rails">
            <span class="chip-icon">🛤️</span>
            <span class="chip-label">Rails</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleInstruction" data-instruction="aws">
            <span class="chip-icon">☁️</span>
            <span class="chip-label">AWS</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleInstruction" data-instruction="gcp">
            <span class="chip-icon">🌐</span>
            <span class="chip-label">GCP</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleInstruction" data-instruction="python">
            <span class="chip-icon">🐍</span>
            <span class="chip-label">Python</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleInstruction" data-instruction="typescript">
            <span class="chip-icon">📘</span>
            <span class="chip-label">TypeScript</span>
          </button>
        </div>
      </div>

      <!-- CLI Tools Selector (left hand) -->
      <div class="selector-group">
        <span class="selector-label"><strong>CLI Tools:</strong></span>
        <div class="selector-chips" data-agent-builder-target="cliChips">
          <button class="chip-btn selected" data-action="click->agent-builder#toggleCli" data-cli="bash">
            <img src="images/mcp-logos/bash.svg" alt="Bash" class="chip-logo">
            <span class="chip-label">Bash</span>
          </button>
          <button class="chip-btn selected" data-action="click->agent-builder#toggleCli" data-cli="git">
            <img src="images/mcp-logos/git.svg" alt="Git" class="chip-logo">
            <span class="chip-label">Git</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleCli" data-cli="ruby">
            <img src="images/mcp-logos/ruby.svg" alt="Ruby" class="chip-logo">
            <span class="chip-label">Ruby</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleCli" data-cli="gh">
            <img src="images/mcp-logos/github.svg" alt="GitHub CLI" class="chip-logo">
            <span class="chip-label">gh CLI</span>
          </button>
        </div>
      </div>

      <!-- MCP Services Selector (right hand) -->
      <div class="selector-group">
        <span class="selector-label"><strong>MCP Services:</strong></span>
        <div class="selector-chips" data-agent-builder-target="mcpChips">
          <button class="chip-btn" data-action="click->agent-builder#toggleMcp" data-mcp="playwright">
            <img src="images/mcp-logos/playwright.svg" alt="Playwright" class="chip-logo">
            <span class="chip-label">Playwright</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleMcp" data-mcp="slack">
            <img src="images/mcp-logos/slack.svg" alt="Slack" class="chip-logo">
            <span class="chip-label">Slack</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleMcp" data-mcp="github">
            <img src="images/mcp-logos/github.svg" alt="GitHub" class="chip-logo">
            <span class="chip-label">GitHub</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleMcp" data-mcp="linear">
            <img src="images/mcp-logos/linear.svg" alt="Linear" class="chip-logo">
            <span class="chip-label">Linear</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleMcp" data-mcp="sentry">
            <img src="images/mcp-logos/sentry.svg" alt="Sentry" class="chip-logo">
            <span class="chip-label">Sentry</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleMcp" data-mcp="postgres">
            <img src="images/mcp-logos/postgresql.svg" alt="PostgreSQL" class="chip-logo">
            <span class="chip-label">Postgres</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleMcp" data-mcp="notion">
            <img src="images/mcp-logos/notion.svg" alt="Notion" class="chip-logo">
            <span class="chip-label">Notion</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleMcp" data-mcp="figma">
            <img src="images/mcp-logos/figma.svg" alt="Figma" class="chip-logo">
            <span class="chip-label">Figma</span>
          </button>
          <button class="chip-btn" data-action="click->agent-builder#toggleMcp" data-mcp="huggingface">
            <img src="images/mcp-logos/huggingface.svg" alt="HuggingFace" class="chip-logo">
            <span class="chip-label">HuggingFace</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Config Display -->
    <div class="agent-config" data-agent-builder-target="config">
      <span class="config-instructions"><strong>Instructions:</strong> <span data-agent-builder-target="configInstructions">🐙 GitHub</span></span>
      <span class="config-tools"><strong>CLI:</strong> <span data-agent-builder-target="configCli">bash, git</span></span>
      <span class="config-mcp"><strong>MCP:</strong> <span data-agent-builder-target="configMcp">None</span></span>
    </div>
  </div>

  <a href="#features" class="scroll-indicator">
    <span>See what's included</span>
    <i class="fa-solid fa-chevron-down chevron"></i>
  </a>
</section>
