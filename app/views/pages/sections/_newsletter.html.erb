<section class="newsletter-section" id="newsletter">
  <div class="heading centered">
    <h2>Stay up to date</h2>
    <p class="paragraph l secondary balanced">
      Get the latest news, updates, and releases delivered to your inbox.
    </p>
  </div>

  <div class="newsletter-form-container">
    <form
      action="https://remoteworkera.us7.list-manage.com/subscribe/post-json?u=a5e2d973d5bb834e4c2693a3f&amp;id=a1c5e41527&amp;f_id=001d43e4f0&amp;c=?"
      method="GET"
      id="newsletter-form"
      class="newsletter-form"
    >
      <div class="newsletter-input-group">
        <input
          type="email"
          name="EMAIL"
          placeholder="Enter your email"
          required
          class="newsletter-input"
          id="newsletter-email"
        >
        <button type="submit" class="button primary newsletter-submit">
          <span class="submit-text">Subscribe</span>
          <span class="submit-loading" style="display: none;">
            <i class="fa-solid fa-spinner fa-spin"></i>
          </span>
        </button>
      </div>
      <!-- Honeypot field for spam protection -->
      <div style="position: absolute; left: -5000px;" aria-hidden="true">
        <input type="text" name="b_a5e2d973d5bb834e4c2693a3f_a1c5e41527" tabindex="-1" value="">
      </div>
    </form>

    <div id="newsletter-response" class="newsletter-response"></div>

    <p class="paragraph s tertiary margin-top-m">
      No spam. Unsubscribe anytime.
    </p>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('newsletter-form');
  const responseDiv = document.getElementById('newsletter-response');
  const submitBtn = form.querySelector('.newsletter-submit');
  const submitText = submitBtn.querySelector('.submit-text');
  const submitLoading = submitBtn.querySelector('.submit-loading');

  form.addEventListener('submit', function(e) {
    e.preventDefault();

    const email = document.getElementById('newsletter-email').value;
    if (!email) return;

    // Show loading state
    submitText.style.display = 'none';
    submitLoading.style.display = 'inline';
    submitBtn.disabled = true;
    responseDiv.innerHTML = '';
    responseDiv.className = 'newsletter-response';

    // Create JSONP request
    const script = document.createElement('script');
    const callbackName = 'mc_callback_' + Date.now();

    window[callbackName] = function(response) {
      // Reset button state
      submitText.style.display = 'inline';
      submitLoading.style.display = 'none';
      submitBtn.disabled = false;

      if (response.result === 'success') {
        responseDiv.innerHTML = '<i class="fa-solid fa-check"></i> ' + response.msg;
        responseDiv.className = 'newsletter-response success';
        form.reset();
      } else {
        let msg = response.msg || 'An error occurred. Please try again.';
        // Clean up Mailchimp error messages
        if (msg.includes('already subscribed')) {
          msg = 'You\'re already subscribed! Check your inbox for updates.';
        } else if (msg.includes('0 -')) {
          msg = msg.substring(msg.indexOf('0 -') + 4);
        }
        responseDiv.innerHTML = '<i class="fa-solid fa-exclamation-circle"></i> ' + msg;
        responseDiv.className = 'newsletter-response error';
      }

      // Cleanup
      delete window[callbackName];
      script.remove();
    };

    // Build URL with email parameter
    const url = form.action.replace('c=?', 'c=' + callbackName) + '&EMAIL=' + encodeURIComponent(email);
    script.src = url;

    script.onerror = function() {
      submitText.style.display = 'inline';
      submitLoading.style.display = 'none';
      submitBtn.disabled = false;
      responseDiv.innerHTML = '<i class="fa-solid fa-exclamation-circle"></i> Connection error. Please try again.';
      responseDiv.className = 'newsletter-response error';
      delete window[callbackName];
      script.remove();
    };

    document.body.appendChild(script);
  });
});
</script>
