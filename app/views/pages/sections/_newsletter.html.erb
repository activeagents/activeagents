<section class="newsletter-section" id="newsletter">
  <div class="heading centered">
    <h2>Stay up to date</h2>
    <p class="paragraph l secondary balanced">
      Get the latest news, updates, and releases delivered to your inbox.
    </p>
  </div>

  <div class="newsletter-form-container" data-controller="signup" data-signup-source-value="newsletter" data-signup-response-class-value="newsletter-response" data-signup-redirect-value="false" data-signup-success-message-value="You&#39;re in! Check your email to confirm.">
    <%= form_with url: registration_path, method: :post, id: "newsletter-form", class: "newsletter-form", data: { turbo: false, signup_target: "form" } do |f| %>
      <div class="newsletter-input-group">
        <%= f.email_field :email_address,
            placeholder: "Enter your email",
            required: true,
            class: "newsletter-input",
            id: "newsletter-email",
            autocomplete: "email",
            data: { signup_target: "email" } %>
        <button type="submit" class="button primary newsletter-submit" data-signup-target="submit">
          <span class="submit-text" data-signup-target="submitText">Subscribe</span>
          <span class="submit-loading" style="display: none;" data-signup-target="submitLoading">
            <i class="fa-solid fa-spinner fa-spin"></i>
          </span>
        </button>
      </div>
    <% end %>

    <div id="newsletter-response" class="newsletter-response" data-signup-target="response"></div>

    <p class="paragraph s tertiary margin-top-m">
      No spam. Unsubscribe anytime.
    </p>
  </div>
</section>
