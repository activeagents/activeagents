<section id="newsletter" class="lp-anchor">
  <div class="lp-cta">
    <span class="eyebrow lp-eyebrow">Newsletter</span>
    <h2 class="no-top-margin balanced">Release notes, in your inbox.</h2>
    <p class="paragraph m secondary balanced">
      Weekly release notes, event announcements and updates from the Active Agent team.
    </p>
    <%= form_with url: newsletter_subscription_path, method: :post, id: "newsletter-form", class: "lp-form",
          data: { turbo: false, controller: "newsletter", action: "submit->newsletter#submit" } do |f| %>
      <%= f.email_field :email_address,
            placeholder: "you@example.com",
            required: true,
            autocomplete: "email",
            class: "lp-input",
            id: "newsletter-email",
            aria: { label: "Email address" },
            data: { newsletter_target: "email" } %>
      <button type="submit" class="button primary" data-newsletter-target="submit">Subscribe</button>
      <p class="lp-form-response lp-mono" data-newsletter-target="response" aria-live="polite"></p>
    <% end %>
    <p class="paragraph s tertiary" style="margin: 0;">One email a week. Unsubscribe anytime.</p>
  </div>
</section>
