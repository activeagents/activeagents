<section id="features">
  <div class="heading centered fade-in-up" data-controller="scroll-animate">
    <h2 class="no-top-margin">What's in the Box</h2>
    <p class="paragraph m secondary">
      Everything to build agents in Rails. Free forever.
    </p>
  </div>
  <div class="grid columns-3 stagger-children" data-controller="scroll-animate">
    <%# Example: test/agents/examples/flip_card_examples.rb %>
    <%= render "pages/components/flip_card",
      title: "Agents are Controllers",
      description: "Actions, callbacks, views. Your agents speak Rails.",
      code: <<~CODE,
        class TranslationAgent < ApplicationAgent
          generate_with :openai, model: "gpt-4o"

          def translate
            prompt message: "Translate '\#{params[:text]}' to \#{params[:target_lang]}"
          end
        end

        TranslationAgent.with(text: "Hello", target_lang: "es").translate.generate_now
      CODE
      docs_link: "https://docs.activeagents.ai/agents",
      docs_text: "docs/agents" %>

    <%# Example: test/agents/examples/flip_card_examples.rb %>
    <%= render "pages/components/flip_card",
      title: "Action Prompt",
      description: "Composable prompts. Like Action Mailer, but for AI.",
      code: <<~CODE,
        def summarize
          prompt(
            instructions: "Summarize in 2-3 sentences",
            message: params[:text],
            temperature: 0.3
          )
        end

        SummaryAgent.with(text:).summarize.generate_now
      CODE
      docs_link: "https://docs.activeagents.ai/actions",
      docs_text: "docs/actions" %>

    <%# Example: test/agents/examples/flip_card_examples.rb %>
    <%= render "pages/components/flip_card",
      title: "Any LLM",
      description: "OpenAI, Anthropic, Ollama. Switch with one line.",
      code: <<~CODE,
        # OpenAI
        generate_with :open_ai, model: "gpt-4o"

        # Anthropic
        generate_with :anthropic, model: "claude-sonnet-4-5-20250929"

        # Ollama (local)
        generate_with :ollama, model: "llama3"
      CODE
      docs_link: "https://docs.activeagents.ai/providers",
      docs_text: "docs/providers" %>
  </div>
  <div class="grid columns-3 stagger-children" data-controller="scroll-animate">
    <%# Example: test/agents/examples/flip_card_examples.rb %>
    <%= render "pages/components/flip_card",
      title: "Resilient by Default",
      description: "Retries, backoff, graceful failures. Agents that don't give up.",
      code: <<~CODE,
        class ReliableAgent < ApplicationAgent
          generate_with :openai,
            model: "gpt-4o",
            retries: 3,
            backoff: :exponential

          on_error :handle_failure
        end
      CODE
      docs_link: "https://docs.activeagents.ai/agents/retries",
      docs_text: "docs/agents/retries" %>

    <%# Example: test/agents/examples/flip_card_examples.rb %>
    <%= render "pages/components/flip_card",
      title: "Streaming",
      description: "Real-time responses. Your agents think out loud.",
      code: <<~CODE,
        class ChatAgent < ApplicationAgent
          generate_with :openai, model: "gpt-4o", stream: true

          on_stream :handle_chunk

          def chat
            prompt message: params[:message]
          end

          private

          def handle_chunk(chunk)
            print chunk.delta if chunk.delta
          end
        end
      CODE
      docs_link: "https://docs.activeagents.ai/agents/streaming",
      docs_text: "docs/streaming" %>

    <%# Example: test/agents/examples/flip_card_examples.rb %>
    <%= render "pages/components/flip_card",
      title: "Structured Output",
      description: "JSON schemas, typed data. Agents that follow instructions.",
      code: <<~CODE,
        def parse_resume
          prompt(
            message: "Extract: \#{params[:data]}",
            response_format: :json_schema
          )
        end
        # Loads schema from views/agents/*/parse_resume.json
      CODE
      docs_link: "https://docs.activeagents.ai/actions/structured_output",
      docs_text: "docs/structured_output" %>
  </div>
  <div class="grid columns-3 stagger-children" data-controller="scroll-animate">
    <%# Example: test/agents/examples/flip_card_examples.rb %>
    <%= render "pages/components/flip_card",
      title: "Tool Calling",
      description: "AI calls Ruby methods. Fetch data, take actions, make decisions.",
      code: <<~CODE,
        def weather_update
          prompt(
            message: params[:query],
            tools: [{
              name: "get_weather",
              description: "Get weather for a location",
              parameters: { type: "object", properties: {
                location: { type: "string" }
              }, required: ["location"] }
            }]
          )
        end

        def get_weather(location:)
          # AI calls this method automatically
        end
      CODE
      docs_link: "https://docs.activeagents.ai/actions/tools",
      docs_text: "docs/tools" %>

    <%# Example: test/agents/examples/flip_card_examples.rb %>
    <%= render "pages/components/flip_card",
      title: "MCP Support",
      description: "Model Context Protocol. Connect agents to any MCP server.",
      code: <<~CODE,
        generate_with :anthropic,
          model: "claude-sonnet-4-5-20250929",
          mcp_servers: {
            filesystem: {
              command: "npx",
              args: ["-y", "@anthropic/mcp-fs"]
            },
            github: { url: "https://mcp.github.com" }
          }
      CODE
      docs_link: "https://docs.activeagents.ai/agents/mcp",
      docs_text: "docs/mcp" %>

    <%# Example: test/agents/examples/flip_card_examples.rb %>
    <%= render "pages/components/flip_card",
      title: "Background Jobs",
      description: "ActiveJob integration. Run agents async, at scale.",
      code: <<~CODE,
        # Queue for later
        ApplicationAgent.prompt(message: "Analyze").generate_later

        # With options
        ApplicationAgent.prompt(message: "Report").generate_later(
          queue: :reports,
          wait: 5.minutes
        )

        # Configure queue at class level
        self.generate_later_queue_name = :ai_tasks
      CODE
      docs_link: "https://docs.activeagents.ai/agents/generation#asynchronous",
      docs_text: "docs/generation" %>
  </div>
</section>
