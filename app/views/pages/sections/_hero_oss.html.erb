<section class="lp-hero">
  <div class="lp-hero-copy">
    <span class="eyebrow lp-eyebrow"><span class="lp-dot"></span>Open source &middot; MIT</span>
    <h1 class="balanced">Build AI in Rails.<br /><span class="lp-accent-line">Agents are controllers.</span></h1>
    <p class="paragraph l secondary balanced">
      Open-source, provider-agnostic AI agents for Rails. Actions, callbacks and views you already know.
      MIT, free forever.
    </p>
    <%= form_with url: newsletter_subscription_path, method: :post, id: "hero-newsletter", class: "lp-form lp-form-hero",
          data: { turbo: false, controller: "newsletter", action: "submit->newsletter#submit" } do |f| %>
      <%= f.email_field :email_address,
            placeholder: "you@example.com",
            required: true,
            autocomplete: "email",
            class: "lp-input",
            id: "hero-newsletter-email",
            aria: { label: "Email address" },
            data: { newsletter_target: "email" } %>
      <button type="submit" class="button primary" data-newsletter-target="submit">Subscribe</button>
      <p class="lp-form-response lp-mono" data-newsletter-target="response" aria-live="polite"></p>
    <% end %>
    <p class="lp-hero-links">
      Weekly release notes, event announcements and updates.
      <a href="https://docs.activeagents.ai/getting_started" target="_blank" rel="noopener noreferrer">Docs</a>
      <span class="lp-muted">&middot;</span>
      <a href="https://github.com/activeagents/activeagent" target="_blank" rel="noopener noreferrer">GitHub</a>
    </p>
    <div class="lp-install">
      <code><span class="lp-p">$</span> bundle add activeagent</code>
      <span class="lp-sep">&middot;</span>
      <code><span class="lp-p">$</span> rails generate active_agent:install</code>
    </div>
    <ul class="lp-trust" aria-label="At a glance">
      <li><span class="lp-g">*</span>MIT</li>
      <li><span class="lp-g">#</span>Rails 7.2 to 8.1</li>
      <li><span class="lp-g">@</span>Ruby 3.2+</li>
      <li><span class="lp-g">{}</span>10 providers</li>
    </ul>
  </div>

  <%= render "pages/sections/stage" %>

  <p class="paragraph s secondary text-centered" style="margin: 0;">
    Running agents in production? <a href="https://activeagents.ai">Monitor them at activeagents.ai</a>
  </p>
</section>
