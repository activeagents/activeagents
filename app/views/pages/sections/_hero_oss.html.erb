<section>
  <div class="heading hero centered">
    <h1 class="balanced">
      <span class="color-accent">Active Agent</span><br />
      Build AI in Rails
    </h1>
    <p class="paragraph l secondary balanced">
      The open-source framework for AI agents in Rails — agents, actions,
      and prompts that feel like the Rails you already know. MIT licensed,
      provider-agnostic, free forever.
    </p>
    <div class="button-group margin-paragraph centered">
      <%= link_to "Get Started", "https://docs.activeagents.ai/getting_started", class: "button primary" %>
      <%= link_to "GitHub", "https://github.com/activeagents/activeagent", class: "button tertiary" %>
    </div>
    <p class="paragraph s secondary">
      Running agents in production?
      <%= link_to "Monitor them at activeagents.ai", "https://activeagents.ai" %>
    </p>
  </div>

  <a href="#features" class="scroll-indicator">
    <span>See what's included</span>
    <i class="fa-solid fa-chevron-down chevron"></i>
  </a>
</section>
