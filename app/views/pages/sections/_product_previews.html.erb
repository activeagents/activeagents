<section class="product-previews-section">
  <div class="heading centered fade-in-up" data-controller="scroll-animate">
    <h2 class="no-top-margin">Observe Every Interaction</h2>
    <p class="paragraph m secondary">
      Trace, measure, and evaluate your agents. Built-in observability for production AI.
    </p>
  </div>

  <div class="preview-grid fade-in-up" data-controller="scroll-animate">
    <div class="preview-row">
      <%= render "pages/components/product_preview",
        title: "Trace Timeline",
        description: "Every call broken into spans. See prompts, reasoning, LLM calls, and tool use with token costs.",
        preview_type: :trace_timeline %>

      <%= render "pages/components/product_preview",
        title: "Evaluations",
        description: "Score outputs with LLM-as-judge, rule-based checks, or custom criteria. Catch regressions early.",
        preview_type: :evaluation %>
    </div>

    <div class="preview-row">
      <%= render "pages/components/product_preview",
        title: "Metrics",
        description: "Track requests, latency, costs, and token usage across all agents in real-time.",
        preview_type: :metrics_dashboard %>

      <%= render "pages/components/product_preview",
        title: "Interactions",
        description: "Message fragments cached for replay. Tool calls are deterministic. Extended thinking captured.",
        preview_type: :session_log %>
    </div>
  </div>
</section>
