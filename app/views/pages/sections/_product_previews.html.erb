<section class="product-previews-section">
  <div class="heading centered fade-in-up" data-controller="scroll-animate">
    <h2 class="no-top-margin">Observe Every Interaction</h2>
    <p class="paragraph m secondary">
      Build with the gem's dev console, then point your telemetry at the
      platform for production. Same traces, same pipeline — every workspace
      starts with a free trial.
    </p>
  </div>

  <div class="preview-grid fade-in-up" data-controller="scroll-animate">
    <div class="preview-row">
      <%= render "pages/components/product_preview",
        title: "Trace Timeline",
        description: "Every run broken into spans — prompt, LLM call, tool use, thinking — with tokens and estimated cost.",
        preview_type: :trace_timeline %>

      <%= render "pages/components/product_preview",
        title: "Evaluations",
        description: "Rule-based checks and LLM-as-judge scores over real agent output. Catch regressions early.",
        preview_type: :evaluation %>
    </div>

    <div class="preview-row">
      <%= render "pages/components/product_preview",
        title: "Metrics",
        description: "Requests, latency, error rate, tokens, and estimated cost — per agent, updated live.",
        preview_type: :metrics_dashboard %>

      <%= render "pages/components/product_preview",
        title: "Interactions",
        description: "Every conversation persisted — messages, tool calls, prompt-cache hits, and thinking tokens, linked to their traces.",
        preview_type: :session_log %>
    </div>
  </div>
</section>
