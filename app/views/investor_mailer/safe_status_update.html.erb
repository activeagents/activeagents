<h2>SAFE Agreement Update</h2>

<p>Hi <%= @investor.name %>,</p>

<% case @safe.status %>
<% when "sent" %>
  <p>Your SAFE agreement with <strong><%= @account.name %></strong> is ready for your signature.</p>

  <div style="background-color: #f5f5f5; padding: 16px; border-radius: 8px; margin: 16px 0;">
    <strong>Investment Amount:</strong> $<%= number_with_delimiter(@safe.investment_amount) %><br>
    <% if @safe.valuation_cap %>
      <strong>Valuation Cap:</strong> $<%= number_with_delimiter(@safe.valuation_cap) %><br>
    <% end %>
    <% if @safe.discount_percent %>
      <strong>Discount:</strong> <%= @safe.discount_percent %>%<br>
    <% end %>
    <strong>Type:</strong> <%= @safe.safe_type.titleize %> SAFE
  </div>

  <p>Please review and sign your agreement at your earliest convenience.</p>

<% when "signed" %>
  <p>Great news! Your SAFE agreement with <strong><%= @account.name %></strong> has been fully executed.</p>

  <div style="background-color: #e8f5e9; padding: 16px; border-radius: 8px; margin: 16px 0;">
    <strong>Investment Amount:</strong> $<%= number_with_delimiter(@safe.investment_amount) %><br>
    <strong>Status:</strong> Signed on <%= @safe.signed_at.strftime("%B %d, %Y") %>
  </div>

  <p>Thank you for your investment. You can view your SAFE agreement in the investor portal.</p>

<% when "converted" %>
  <p>Your SAFE agreement with <strong><%= @account.name %></strong> has converted to equity!</p>

  <div style="background-color: #e3f2fd; padding: 16px; border-radius: 8px; margin: 16px 0;">
    <strong>Original Investment:</strong> $<%= number_with_delimiter(@safe.investment_amount) %><br>
    <strong>Shares Received:</strong> <%= number_with_delimiter(@safe.conversion_shares) %><br>
    <strong>Price Per Share:</strong> $<%= number_with_precision(@safe.conversion_price_per_share, precision: 4) %><br>
    <strong>Round:</strong> <%= @safe.conversion_round_name %>
  </div>

  <p>Congratulations! You are now a shareholder in <%= @account.name %>.</p>
<% end %>

<p>
  <%= link_to "View in Investor Portal", @portal_url, style: "display: inline-block; padding: 12px 24px; background-color: #FA343B; color: white; text-decoration: none; border-radius: 6px; font-weight: 600;" %>
</p>

<p>
  Best regards,<br>
  The <%= @account.name %> Team
</p>
