<!DOCTYPE html>
<html lang="en" class="theme-light">

<head>
  <meta charset="utf-8" />
  <title><%= content_for(:title) || "Active Agent | The AI Framework For Ruby on Rails" %></title>
  <meta content="Build AI in Rails - Now Agents are Controllers. The Ruby-native way to build AI features." name="description" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Active Agent" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="Active Agent | The AI Framework For Ruby on Rails" />
  <meta property="og:description" content="Build AI in Rails - Now Agents are Controllers. Makes code tons of fun!" />
  <meta property="og:url" content="https://activeagents.ai" />
  <meta name="twitter:site" content="@activeagents" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Active Agent | The AI Framework For Ruby on Rails" />
  <meta name="twitter:description" content="Build AI in Rails - Now Agents are Controllers." />

  <!-- Favicon and icons -->
  <link rel="icon" href="/images/activeagent-logo.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/images/activeagent-logo.png" />

  <!-- Preload fonts -->
  <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Styles (absolute paths - converted to relative by rake task) -->
  <link href="/vendor/font-awesome-6.7.2/css/all.min.css" rel="stylesheet" />
  <link href="/css/base.css" rel="stylesheet" />
  <link href="/css/pricing.css" rel="stylesheet" />
  <link href="/css/tablet.css" rel="stylesheet" media="(max-width: 1024px)" />
  <link href="/css/mobile.css" rel="stylesheet" media="(max-width: 600px)" />
</head>

<body>
  <div class="background-gradient"></div>
  <div class="page-container">
    <%= render "layouts/landing/header" %>

    <main>
      <%= yield %>
    </main>

    <%= render "layouts/landing/footer" %>
  </div>

  <!-- JS for mobile nav and theme toggle -->
  <script>
    // Mobile navigation toggle
    (function() {
      const hamburger = document.querySelector('.nav-hamburger');
      const navMenu = document.querySelector('.nav-menu');

      if (hamburger && navMenu) {
        hamburger.addEventListener('click', () => {
          navMenu.classList.toggle('open');
          hamburger.classList.toggle('active');
        });

        // Close menu when clicking outside
        document.addEventListener('click', (e) => {
          if (!hamburger.contains(e.target) && !navMenu.contains(e.target)) {
            navMenu.classList.remove('open');
            hamburger.classList.remove('active');
          }
        });

        // Close menu when clicking nav links
        navMenu.querySelectorAll('.nav-link').forEach(link => {
          link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            if (href && href.startsWith('#')) {
              e.preventDefault();
              navMenu.classList.remove('open');
              hamburger.classList.remove('active');
              setTimeout(() => {
                const target = document.querySelector(href);
                if (target) {
                  target.scrollIntoView({ behavior: 'smooth' });
                  history.pushState(null, null, href);
                }
              }, 150);
            } else {
              navMenu.classList.remove('open');
              hamburger.classList.remove('active');
            }
          });
        });
      }
    })();

    // Theme toggle
    (function() {
      const html = document.documentElement;
      const themeBtn = document.querySelector('[aria-label="Toggle dark mode"]');

      // Check saved preference or system preference
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        html.className = savedTheme;
      } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        html.className = 'theme-dark';
      }

      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const newTheme = html.className === 'theme-light' ? 'theme-dark' : 'theme-light';
          html.className = newTheme;
          localStorage.setItem('theme', newTheme);
        });
      }

      // Listen for system theme changes
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          html.className = e.matches ? 'theme-dark' : 'theme-light';
        }
      });
    })();

    // Agent Builder (hero section)
    (function() {
      const mcps = {
        playwright: { emoji: '🎭', label: 'Playwright' },
        filesystem: { emoji: '📁', label: 'Filesystem' },
        github: { emoji: '🐙', label: 'GitHub' },
        database: { emoji: '🗄️', label: 'Database' },
        slack: { emoji: '💬', label: 'Slack' },
        memory: { emoji: '🧠', label: 'Memory' },
        fetch: { emoji: '🌐', label: 'Fetch' },
        huggingface: { emoji: '🤗', label: 'Hugging Face' },
      };

      const tools = {
        terminal: { emoji: '💻', label: 'Terminal' },
        browser: { emoji: '🌐', label: 'Browser' },
        document: { emoji: '📄', label: 'Read' },
        edit: { emoji: '✏️', label: 'Edit' },
        search: { emoji: '🔍', label: 'Search' },
        code: { emoji: '👨‍💻', label: 'Code' },
        translate: { emoji: '🌍', label: 'Translate' },
        vision: { emoji: '👁️', label: 'Vision' },
        voice: { emoji: '🗣️', label: 'Voice' },
      };

      const presets = {
        'claude-code': { mcps: ['filesystem', 'github'], tools: ['terminal', 'edit', 'search'] },
        'web-scraper': { mcps: ['playwright', 'fetch'], tools: ['browser', 'document'] },
        'data-analyst': { mcps: ['database', 'filesystem'], tools: ['search', 'code'] },
        'devops': { mcps: ['github', 'slack'], tools: ['terminal', 'code'] },
        'polyglot': { mcps: ['memory'], tools: ['translate', 'document'] },
        'research': { mcps: ['fetch', 'memory'], tools: ['browser', 'search', 'document'] },
      };

      const mcpsContainer = document.querySelector('.agent-mcps');
      const toolsContainer = document.querySelector('.agent-tools');
      const speechLeft = document.querySelector('.agent-speech-left');
      const speechRight = document.querySelector('.agent-speech-right');
      const configMcps = document.querySelector('[data-config="mcps"]');
      const configTools = document.querySelector('[data-config="tools"]');
      const presetBtns = document.querySelectorAll('.preset-btn');

      function renderPreset(presetName) {
        const preset = presets[presetName];
        if (!preset) return;

        // Render MCPs
        if (mcpsContainer) {
          mcpsContainer.innerHTML = preset.mcps.map((id, i) => {
            const mcp = mcps[id];
            return mcp ? `<span class="mcp-item" style="animation-delay: ${i * 0.5}s" title="${mcp.label}">${mcp.emoji}</span>` : '';
          }).join('');
        }

        // Render tools (excluding translate which shows as speech bubbles)
        if (toolsContainer) {
          const displayTools = preset.tools.filter(id => id !== 'translate');
          toolsContainer.innerHTML = displayTools.map(id => {
            const tool = tools[id];
            return tool ? `<span class="tool-item" title="${tool.label}">${tool.emoji}</span>` : '';
          }).join('');
        }

        // Handle translation speech bubbles
        const hasTranslate = preset.tools.includes('translate');
        if (speechLeft) speechLeft.style.display = hasTranslate ? 'block' : 'none';
        if (speechRight) speechRight.style.display = hasTranslate ? 'block' : 'none';

        // Update config display
        if (configMcps) {
          configMcps.textContent = preset.mcps.map(id => mcps[id] ? `${mcps[id].emoji} ${mcps[id].label}` : '').filter(Boolean).join(', ') || 'None';
        }
        if (configTools) {
          configTools.textContent = preset.tools.map(id => tools[id] ? `${tools[id].emoji} ${tools[id].label}` : '').filter(Boolean).join(', ') || 'None';
        }
      }

      // Bind preset buttons
      presetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          presetBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          renderPreset(btn.dataset.preset);
        });
      });

      // Initialize with claude-code preset
      renderPreset('claude-code');
    })();

    // Session Replay - User interaction mode
    (function() {
      const viewport = document.querySelector('.browser-viewport');
      if (!viewport) return;

      viewport.addEventListener('mouseenter', () => {
        viewport.classList.add('user-mode');
        // Focus the card input when entering
        const cardInput = viewport.querySelector('.card-field .user-input');
        if (cardInput) {
          setTimeout(() => cardInput.focus(), 100);
        }
      });

      viewport.addEventListener('mouseleave', () => {
        viewport.classList.remove('user-mode');
        // Clear inputs on leave so animation shows properly
        viewport.querySelectorAll('.user-input').forEach(input => {
          input.value = '';
          input.blur();
        });
      });

      // Handle Pay button click in user mode
      const payBtn = viewport.querySelector('.checkout-btn');
      if (payBtn) {
        payBtn.addEventListener('click', (e) => {
          if (viewport.classList.contains('user-mode')) {
            e.preventDefault();
            payBtn.textContent = 'Processing...';
            payBtn.style.opacity = '0.7';
            setTimeout(() => {
              payBtn.textContent = 'Payment Successful!';
              payBtn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
              payBtn.style.opacity = '1';
            }, 1000);
            setTimeout(() => {
              payBtn.textContent = 'Pay $49.00';
              payBtn.style.background = '';
              payBtn.style.opacity = '';
            }, 3000);
          }
        });
      }
    })();
  </script>
</body>

</html>
