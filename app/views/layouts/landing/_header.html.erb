<header class="nav-container" data-controller="theme-toggle mobile-menu">
  <%= link_to "/", class: "nav-brand", style: "display: flex; align-items: center; gap: 8px;" do %>
    <div class="logo-container" style="height: 32px; width: 32px;">
      <img src="/images/activeagent-logo.svg" alt="Active Agent" class="logo-light" style="height: 32px; width: 32px;" />
      <img src="/images/activeagent-logo-dark.svg" alt="Active Agent" class="logo-dark" style="height: 32px; width: 32px;" />
    </div>
    <span style="font-size: 1.25rem; font-weight: 600;">Active Agent</span>
  <% end %>
  <nav role="navigation" class="nav-menu" data-mobile-menu-target="menu">
    <% if defined?(oss_site?) && oss_site? %>
      <%= link_to "Dev Console", "#dev-console", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Gems", "#gems", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Platform", "https://activeagents.ai", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
    <% else %>
      <%= link_to "Gems", "#gems", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Services", "#services", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Hosting", "#hosting", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Contact", "#contact", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
    <% end %>
    <%= link_to "Docs", "https://docs.activeagents.ai", class: "nav-link", target: "_blank", rel: "noopener noreferrer", data: { action: "click->mobile-menu#close" } %>
    <div class="button-group stacked margin-top-l mobile-only">
      <%= link_to "Sign In", dashboard_path, class: "button tertiary" %>
      <%= link_to "Getting Started", "https://docs.activeagents.ai/getting_started", class: "button primary", target: "_blank", rel: "noopener noreferrer" %>
    </div>
  </nav>
  <div class="button-group">
    <%= link_to "https://discord.gg/activeagent", class: "button ghost compact hide-on-mobile", target: "_blank", rel: "noopener noreferrer" do %>
      <div class="fa-brands fa-discord icon l"></div>
    <% end %>
    <%= link_to "https://github.com/activeagents/activeagent", class: "github-stars-badge hide-on-mobile", target: "_blank", rel: "noopener noreferrer", data: { controller: "github-stars", github_stars_repo_value: "activeagents/activeagent" } do %>
      <div class="fa-brands fa-github github-stars-icon"></div>
      <span class="github-stars-label">Star</span>
      <span class="github-stars-divider"></span>
      <span class="github-stars-count" data-github-stars-target="count"></span>
    <% end %>
    <button class="button ghost compact" data-action="theme-toggle#toggle" aria-label="Toggle dark mode">
      <span class="theme-icon-sun fa-solid fa-sun icon m"></span>
      <span class="theme-icon-moon fa-solid fa-moon icon m"></span>
    </button>
    <%= link_to "Sign In", dashboard_path, class: "button tertiary compact hide-on-mobile" %>
    <button class="button ghost compact nav-hamburger" data-action="mobile-menu#toggle" aria-label="Show menu">
      <span class="fa-solid fa-bars icon m"></span>
    </button>
  </div>
</header>
