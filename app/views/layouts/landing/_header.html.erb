<%# The bar: brand, menu, actions. Below 1057px the menu folds behind the
    hamburger; below 768px Discord, the stars and the sign-in leave the bar
    for the menu (.nav-wide hides, .nav-narrow shows). A signed-in visitor
    gets their dashboard where a visitor gets Sign In. %>
<header class="nav-container" data-controller="theme-toggle mobile-menu github-stars" data-github-stars-repo-value="activeagents/activeagent">
  <%= link_to "/", class: "nav-brand", style: "display: flex; align-items: center; gap: 8px;" do %>
    <div class="logo-container" style="height: 32px; width: 32px;">
      <img src="/images/activeagent-logo.svg" alt="Active Agent" class="logo-light" style="height: 32px; width: 32px;" />
      <img src="/images/activeagent-logo-dark.svg" alt="Active Agent" class="logo-dark" style="height: 32px; width: 32px;" />
    </div>
    <span style="font-size: 1.25rem; font-weight: 600;">Active Agent</span>
  <% end %>
  <nav role="navigation" class="nav-menu" data-mobile-menu-target="menu">
    <% if defined?(oss_site?) && oss_site? %>
      <%= link_to "Framework", "#framework", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Dev Console", "#dev-console", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Gems", "#gems", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Platform", "https://activeagents.ai", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
    <% else %>
      <%= link_to "Framework", "#framework", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Dashboard", "#dashboard", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Platform", "#platform", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "Pricing", "#pricing", class: "nav-link", data: { action: "click->mobile-menu#close" } %>
    <% end %>
    <%= link_to "Docs", "https://docs.activeagents.ai", class: "nav-link", target: "_blank", rel: "noopener noreferrer", data: { action: "click->mobile-menu#close" } %>
    <div class="nav-narrow nav-menu-actions">
      <% if authenticated? %>
        <%= link_to "Go to your dashboard", dashboard_path, class: "button primary" %>
      <% else %>
        <%= link_to "Sign In", dashboard_path, class: "button tertiary" %>
        <%= link_to "Start Free", "/registration/new", class: "button primary" %>
      <% end %>
      <div class="nav-menu-links">
        <%= link_to "https://discord.gg/activeagent", class: "button ghost compact", target: "_blank", rel: "noopener noreferrer", aria: { label: "Discord" } do %>
          <div class="fa-brands fa-discord icon l"></div>
        <% end %>
        <%= link_to "https://github.com/activeagents/activeagent", class: "github-stars-badge", target: "_blank", rel: "noopener noreferrer" do %>
          <div class="fa-brands fa-github github-stars-icon"></div>
          <span class="github-stars-label">Star</span>
          <span class="github-stars-divider"></span>
          <span class="github-stars-count" data-github-stars-target="count"></span>
        <% end %>
      </div>
    </div>
  </nav>
  <div class="nav-actions">
    <%= link_to "https://discord.gg/activeagent", class: "button ghost compact nav-wide", target: "_blank", rel: "noopener noreferrer", aria: { label: "Discord" } do %>
      <div class="fa-brands fa-discord icon l"></div>
    <% end %>
    <%= link_to "https://github.com/activeagents/activeagent", class: "github-stars-badge nav-wide", target: "_blank", rel: "noopener noreferrer" do %>
      <div class="fa-brands fa-github github-stars-icon"></div>
      <span class="github-stars-label">Star</span>
      <span class="github-stars-divider"></span>
      <span class="github-stars-count" data-github-stars-target="count"></span>
    <% end %>
    <button class="button ghost compact" data-action="theme-toggle#toggle" aria-label="Toggle dark mode">
      <span class="theme-icon-sun fa-solid fa-sun icon m"></span>
      <span class="theme-icon-moon fa-solid fa-moon icon m"></span>
    </button>
    <% if authenticated? %>
      <%= link_to "Dashboard", dashboard_path, class: "button primary compact nav-wide" %>
    <% else %>
      <%= link_to "Sign In", dashboard_path, class: "button tertiary compact nav-wide" %>
    <% end %>
    <button class="button ghost compact nav-hamburger" data-action="mobile-menu#toggle" aria-label="Show menu" aria-expanded="false">
      <span class="fa-solid fa-bars icon m"></span>
    </button>
  </div>
</header>
