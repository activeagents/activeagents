<% providers = [ (@github_identity && "GitHub"), (@google_identity && "Google") ].compact %>
<div class="pilot-narrow">
  <p class="pilot-eyebrow">Account settings</p>
  <h1>How you sign in</h1>
  <p class="pilot-muted">Signed in as <strong><%= @user.email_address %></strong>.</p>

  <section class="pilot-card">
    <h2>Email and password</h2>
    <% if @user.password_set? %>
      <p>You can sign in with your email address and password.</p>
    <% else %>
      <% if providers.one? %>
        <p>You haven't set a password, so <%= providers.first %> is the only way to sign in to this account.</p>
      <% elsif providers.many? %>
        <p>You haven't set a password, so <%= providers.to_sentence %> are the only ways to sign in to this account.</p>
      <% else %>
        <p>You haven't chosen a password yet.</p>
      <% end %>
      <%= button_to "Email me a link to set a password", password_link_path %>
    <% end %>
  </section>

  <section class="pilot-card">
    <h2>GitHub</h2>
    <% if @github_identity %>
      <p>Connected as <strong>@<%= @github_identity.login %></strong>. You can sign in with GitHub.</p>
      <% if @user.signs_in_without?(@github_identity) %>
        <%= button_to "Disconnect GitHub", github_identity_path, method: :delete %>
      <% else %>
        <p class="pilot-muted">Set a password before you disconnect GitHub.</p>
      <% end %>
    <% elsif GithubSignIn.configured? %>
      <p>Connect your GitHub account to sign in with GitHub.</p>
      <%= button_to "Connect GitHub", github_identity_path, form: { data: { turbo: false } } %>
    <% else %>
      <p class="pilot-muted">Sign in with GitHub isn't available here.</p>
    <% end %>
  </section>

  <section class="pilot-card">
    <h2>Google</h2>
    <% if @google_identity %>
      <p>Connected as <strong><%= @google_identity.email.presence || "a Google account" %></strong>. You can sign in with Google.</p>
      <% if @user.signs_in_without?(@google_identity) %>
        <%= button_to "Disconnect Google", google_identity_path, method: :delete %>
      <% else %>
        <p class="pilot-muted">Set a password before you disconnect Google.</p>
      <% end %>
    <% elsif GoogleSignIn.configured? %>
      <p>Connect your Google account to sign in with Google.</p>
      <%= button_to "Connect Google", google_identity_path, form: { data: { turbo: false } } %>
    <% else %>
      <p class="pilot-muted">Sign in with Google isn't available here.</p>
    <% end %>
  </section>
</div>
