<div class="min-h-screen bg-gray-50 py-12 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">
    <!-- Progress Steps -->
    <div class="mb-8">
      <div class="flex items-center justify-center space-x-4">
        <div class="flex items-center">
          <span class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center text-white text-sm">
            <i class="fa-solid fa-check"></i>
          </span>
          <span class="ml-2 text-sm font-medium text-gray-900">Create account</span>
        </div>
        <div class="w-12 h-0.5 bg-green-500"></div>
        <div class="flex items-center">
          <span class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center text-white text-sm">
            <i class="fa-solid fa-check"></i>
          </span>
          <span class="ml-2 text-sm font-medium text-gray-900">Verify email</span>
        </div>
        <div class="w-12 h-0.5 bg-rose-500"></div>
        <div class="flex items-center">
          <span class="w-8 h-8 bg-rose-500 rounded-full flex items-center justify-center text-white text-sm">3</span>
          <span class="ml-2 text-sm font-medium text-gray-900">Complete profile</span>
        </div>
      </div>
    </div>

    <div class="bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h2 class="text-2xl font-bold text-gray-900 text-center mb-2">
          Complete your profile
        </h2>
        <p class="text-center text-gray-600 mb-8">
          Tell us a bit about yourself to personalize your experience.
        </p>

        <%= form_with model: @user, url: complete_profile_path, method: :patch, class: "space-y-6" do |form| %>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <%= form.label :first_name, class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= form.text_field :first_name, autofocus: true, required: true,
                    placeholder: "Jane",
                    class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-rose-500 focus:border-rose-500 sm:text-sm" %>
              </div>
            </div>

            <div>
              <%= form.label :last_name, class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= form.text_field :last_name, required: true,
                    placeholder: "Developer",
                    class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-rose-500 focus:border-rose-500 sm:text-sm" %>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <%= form.label :company_name, "Company (optional)", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= form.text_field :company_name,
                    placeholder: "Acme Inc.",
                    class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-rose-500 focus:border-rose-500 sm:text-sm" %>
              </div>
            </div>

            <div>
              <%= form.label :job_title, "Role (optional)", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= form.text_field :job_title,
                    placeholder: "Developer, CTO, Product Manager...",
                    class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-rose-500 focus:border-rose-500 sm:text-sm" %>
              </div>
            </div>
          </div>

          <!-- Password -->
          <div class="border-t border-gray-200 pt-6 mt-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">
              Set your password
            </h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
                <div class="mt-1">
                  <%= form.password_field :password, required: true,
                      autocomplete: "new-password",
                      placeholder: "At least 8 characters",
                      class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-rose-500 focus:border-rose-500 sm:text-sm" %>
                </div>
              </div>

              <div>
                <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700" %>
                <div class="mt-1">
                  <%= form.password_field :password_confirmation, required: true,
                      autocomplete: "new-password",
                      placeholder: "Confirm your password",
                      class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-rose-500 focus:border-rose-500 sm:text-sm" %>
                </div>
              </div>
            </div>
          </div>

          <!-- Plan Selection -->
          <div class="border-t border-gray-200 pt-6 mt-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">
              Choose your plan
            </h3>
            <p class="text-sm text-gray-600 mb-4">
              Start free, upgrade anytime. All plans include the core Active Agent framework.
            </p>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <% @plans.each do |plan| %>
                <label class="relative bg-white border rounded-lg shadow-sm p-4 cursor-pointer hover:border-rose-500 transition-colors plan-card" data-plan="<%= plan.slug %>">
                  <input type="radio" name="plan_slug" value="<%= plan.slug %>"
                         class="sr-only" <%= "checked" if plan.slug == "free" %>>
                  <div class="flex flex-col h-full">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-sm font-semibold text-gray-900"><%= plan.name %></span>
                      <% if plan.slug == "free" %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                          Current
                        </span>
                      <% end %>
                    </div>

                    <div class="mb-3">
                      <% if plan.price_cents == 0 %>
                        <span class="text-2xl font-bold text-gray-900">Free</span>
                      <% else %>
                        <span class="text-2xl font-bold text-gray-900">$<%= plan.price_cents / 100 %></span>
                        <span class="text-sm text-gray-500">/mo</span>
                      <% end %>
                    </div>

                    <ul class="text-xs text-gray-600 space-y-1 flex-grow">
                      <% case plan.slug %>
                      <% when "free" %>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> 1 workspace</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> 3 agents</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> 1,000 traces/mo</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> Community support</li>
                      <% when "pro" %>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> 5 team seats</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> Unlimited agents</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> 25,000 traces/mo</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> Email support</li>
                      <% when "enterprise" %>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> Unlimited seats</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> Unlimited everything</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> SSO, SOC 2, HIPAA</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-1"></i> Dedicated support</li>
                      <% end %>
                    </ul>

                    <div class="mt-3 pt-3 border-t border-gray-100">
                      <span class="plan-select-indicator text-xs text-rose-600 font-medium hidden">
                        <i class="fa-solid fa-check-circle mr-1"></i> Selected
                      </span>
                    </div>
                  </div>

                  <!-- Selected ring -->
                  <div class="absolute -inset-px rounded-lg border-2 pointer-events-none plan-ring border-transparent" aria-hidden="true"></div>
                </label>
              <% end %>
            </div>
          </div>

          <div class="pt-4">
            <%= form.submit "Get Started",
                class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-rose-600 hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-rose-500 cursor-pointer" %>
          </div>

          <p class="text-center text-xs text-gray-500">
            <% if @current_plan&.slug != "free" %>
              You'll be redirected to complete payment after this step.
            <% else %>
              No credit card required. Upgrade anytime from your dashboard.
            <% end %>
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const cards = document.querySelectorAll('.plan-card');

  cards.forEach(card => {
    const radio = card.querySelector('input[type="radio"]');
    const ring = card.querySelector('.plan-ring');
    const indicator = card.querySelector('.plan-select-indicator');

    // Initialize selected state
    if (radio.checked) {
      ring.classList.add('border-rose-500');
      indicator.classList.remove('hidden');
    }

    card.addEventListener('click', function() {
      // Deselect all
      cards.forEach(c => {
        c.querySelector('.plan-ring').classList.remove('border-rose-500');
        c.querySelector('.plan-select-indicator').classList.add('hidden');
      });

      // Select this one
      radio.checked = true;
      ring.classList.add('border-rose-500');
      indicator.classList.remove('hidden');
    });
  });
});
</script>
