<% nav = data["nav"] -%>
    <header class="nav-container">
      <a href="/" class="nav-brand" style="display: flex; align-items: center; gap: 8px;">
        <img src="<%= asset_path(nav["brand"]["logo"]) %>" alt="<%= nav["brand"]["name"] %>" style="height: 32px; width: 32px;" />
        <span style="font-size: 1.25rem; font-weight: 600;"><%= nav["brand"]["name"] %></span>
      </a>
      <nav role="navigation" class="nav-menu" data-navigation>
<% nav["links"].each do |link| -%>
        <a href="<%= link["href"] %>" class="nav-link"><%= link["text"] %></a>
<% end -%>
        <div class="button-group stacked margin-top-l mobile-only">
          <a href="<%= nav["cta"]["sign_in"]["href"] %>" class="button tertiary"><%= nav["cta"]["sign_in"]["text"] %></a>
          <a href="<%= nav["cta"]["primary"]["href"] %>" class="button primary"><%= nav["cta"]["primary"]["text"] %></a>
        </div>
      </nav>
      <div class="button-group">
<% nav["social"].each do |social| -%>
        <a href="<%= social["href"] %>" class="button ghost compact hide-on-mobile">
          <div class="<%= social["icon"] %> icon l"></div>
        </a>
<% end -%>
        <a href="<%= nav["cta"]["sign_in"]["href"] %>" class="button tertiary compact hide-on-mobile"><%= nav["cta"]["sign_in"]["text"] %></a>
        <a href="<%= nav["cta"]["primary"]["href"] %>" class="button primary compact"><%= nav["cta"]["primary"]["text"] %></a>
        <button class="button ghost compact nav-hamburger" data-mobile-toggle aria-label="Show menu">
          <span class="fa-solid fa-bars icon m"></span>
        </button>
      </div>
    </header>
