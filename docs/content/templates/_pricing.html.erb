<% pricing = data["pricing"] -%>
<section id="pricing">
  <div class="text-centered full-width">
    <h2><%= pricing["heading"] %></h2>
    <p class="paragraph m secondary"><%= pricing["subheading"] %></p>
  </div>
  <div class="grid columns-3 margin-top-xl">
<% pricing["plans"].each_with_index do |plan, i| -%>
    <div class="feature-card justified-vertically<%= plan["highlighted"] ? " highlighted" : "" %>">
      <div>
        <div class="feature-heading">
          <p class="paragraph l bold no-top-margin"><%= plan["name"] %></p>
          <p class="paragraph s secondary"><%= h(plan["subtitle"]) %></p>
          <div class="price-line">
            <div class="paragraph l bold"><%= plan["price"] %></div>
<% if plan["price_period"] -%>
            <div class="paragraph m secondary"><%= plan["price_period"] %></div>
<% end -%>
          </div>
        </div>
        <div class="feature-list">
<% plan["features"].each do |feature| -%>
          <div class="feature-item paragraph s">
          <div class="fa-regular fa-square-check icon m"></div>
          <div><%= h(feature) %></div>
        </div>
<% end -%>
        </div>
        <p class="paragraph xs secondary" style="margin-top: 1rem;"><%= plan["best_for"] %></p>
      </div>
      <a href="<%= plan["button"]["href"] %>" class="<%= plan["button"]["class"] %>"><%= plan["button"]["text"] %></a>
    </div>
<% if i < pricing["plans"].length - 1 -%>

<% end -%>
<% end -%>
  </div>
<%= render_partial("_comparison") -%>

</section>
