<% features = data["features"] -%>
<section>
  <div class="heading centered">
    <h2 class="no-top-margin"><%= features["heading"] %></h2>
    <p class="paragraph m secondary">
      <%= features["subheading"] %>
    </p>
  </div>
<% features["items"].each_slice(3) do |row| -%>
  <div class="grid columns-3">
<% row.each do |feature| -%>
    <div class="feature-card">
      <div class="feature-heading">
        <h3 class="color-accent no-top-margin"><%= feature["title"] %></h3>
        <p class="paragraph s secondary">
          <%= h(feature["description"]) %>
        </p>
      </div>
    </div>
<% if feature != row.last -%>

<% end -%>
<% end -%>
</div>
<% end -%>
</section>
