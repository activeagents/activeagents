<% benefits = data["benefits"] -%>
<section>
  <div class="heading centered">
    <h2 class="no-top-margin"><%= benefits["heading"] %></h2>
    <p class="paragraph m secondary">
      <%= benefits["subheading"] %>
    </p>
  </div>
<% benefits["items"].each_slice(2) do |row| -%>
  <div class="grid columns-2">
<% row.each do |item| -%>
    <div class="feature-card benefit-card">
      <div class="benefit-icon">
        <div class="<%= item["icon"] %> icon l color-accent"></div>
      </div>
      <div class="feature-heading">
        <h3 class="no-top-margin"><%= item["title"] %></h3>
        <p class="paragraph s secondary">
          <%= h(item["description"]) %>
        </p>
      </div>
    </div>
<% if item != row.last -%>

<% end -%>
<% end -%>
  </div>
<% end -%>
</section>
