<% comp = data["pricing"]["comparison"] -%>
  <div class="text-centered full-width margin-top-xl">
    <h3 class="no-top-margin">Feature Comparison</h3>
  </div>
  <table class="pricing-table">
    <thead>
      <tr class="pricing-table-row">
<% comp["columns"].each do |col| -%>
        <th class="paragraph s bold"><%= col %></th>
<% end -%>
      </tr>
    </thead>
    <tbody>
<% comp["groups"].each do |group| -%>
      <tr class="pricing-table-row">
        <td class="paragraph s bold" colspan="4" style="background: var(--color-bg-secondary);"><%= group["heading"] %></td>
      </tr>
<% group["rows"].each do |row| -%>
      <tr class="pricing-table-row">
        <td class="paragraph s"><%= row["label"] %></td>
<% row["values"].each do |val| -%>
<% if val == "check" -%>
        <td><div class="fa-regular fa-square-check icon m"></div></td>
<% elsif val.to_s.empty? -%>
        <td></td>
<% else -%>
        <td class="paragraph s"><%= val %></td>
<% end -%>
<% end -%>
      </tr>
<% end -%>
<% end -%>
    </tbody>
  </table>
