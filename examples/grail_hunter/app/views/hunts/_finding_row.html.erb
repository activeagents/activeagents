<%# locals: (finding:, show_hunt: false) %>
<tr>
  <td style="width: 140px"><%= score_bar finding.match_score %></td>
  <td>
    <div class="title"><%= link_to finding.title, finding.url, target: "_blank", rel: "noopener" %></div>
    <div class="sub">
      <%= [ finding.source&.capitalize, finding.condition&.capitalize, (finding.size && "Size #{finding.size}"), (finding.listed_at && "listed #{finding.listed_at.to_date}") ].compact_blank.join(" | ") %>
      <% if show_hunt %> | <%= link_to finding.hunt.title, finding.hunt, class: "link" %><% end %>
    </div>
    <% if finding.rationale.present? %><div class="rationale"><%= finding.rationale %></div><% end %>
    <% if finding.red_flag_list.any? %><div class="flags">Watch out: <%= finding.red_flag_list.join("; ") %></div><% end %>
  </td>
  <td><%= verdict_badge finding %></td>
  <td class="num"><%= money finding.price_cents, finding.currency %></td>
  <td class="nowrap">
    <div class="actions">
      <% unless finding.saved? %><%= button_to "Save", keep_finding_path(finding), method: :patch, class: "btn btn-small btn-secondary" %><% end %>
      <% unless finding.dismissed? %><%= button_to "Pass", dismiss_finding_path(finding), method: :patch, class: "btn btn-small" %><% end %>
      <% if finding.dismissed? || finding.saved? %><%= status_badge finding.status %><% end %>
    </div>
  </td>
</tr>
