<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Grail Hunter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="dark light">
    <meta name="application-name" content="Grail Hunter">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="container topbar-inner">
        <%= link_to root_path, class: "wordmark" do %>
          <span class="glyph">[*]</span> Grail Hunter
        <% end %>

        <nav class="nav">
          <% if authenticated? %>
            <%= nav_link "Hunts", hunts_path, glyph: "@" %>
            <%= link_to findings_path, class: "nav-link #{'is-active' if request.path.start_with?(findings_path)}" do %>
              <span class="glyph">[*]</span> Findings<% if (fresh = current_user.findings.fresh.count).positive? %><span class="count"><%= fresh %></span><% end %>
            <% end %>
            <%= nav_link "Billing", billing_path, glyph: "#" %>
            <% if current_user.admin? %>
              <a class="nav-link" href="/activeagents" data-turbo="false"><span class="glyph">-></span> Dashboard</a>
            <% end %>
          <% else %>
            <%= link_to "Pricing", root_path(anchor: "pricing"), class: "nav-link" %>
          <% end %>
        </nav>

        <% if authenticated? %>
          <div class="user">
            <span class="mono small"><%= current_user.plan.name %></span>
            <span><%= current_user.display_name %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-small" %>
          </div>
        <% else %>
          <div class="actions">
            <%= link_to "Sign in", new_session_path, class: "btn btn-small" %>
            <%= link_to "Get started", new_registration_path, class: "btn btn-small btn-primary" %>
          </div>
        <% end %>
      </div>
    </header>

    <main class="container">
      <% if notice %><div class="flash notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>

    <footer class="container footer dim mono">
      Built on <a class="link" href="https://activeagents.ai">Active Agent</a>. Agents are controllers, hunts are jobs, every run is a trace.
    </footer>
  </body>
</html>
