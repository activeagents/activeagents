<header class="page-header">
  <h1>Support Inbox</h1>
  <p class="subtitle">
    An example Rails app built on the <strong>activeagent</strong> gem —
    triage, drafting, and summaries are real agent generations, monitored
    <%= Rails.env.local? ? link_to("in the dev console", "/activeagents") : "on the ActiveAgents platform".html_safe %>.
  </p>
</header>

<section class="new-ticket">
  <h2>New ticket</h2>
  <%= form_with model: @ticket, url: tickets_path do |f| %>
    <div class="field"><%= f.text_field :subject, placeholder: "Subject", required: true %></div>
    <div class="field"><%= f.email_field :customer_email, placeholder: "customer@example.com", required: true %></div>
    <div class="field"><%= f.text_area :body, placeholder: "What does the customer need?", rows: 3, required: true %></div>
    <%= f.submit "Create ticket" %>
  <% end %>
</section>

<section>
  <h2>Tickets</h2>
  <% if @tickets.none? %>
    <p class="empty">No tickets yet — run <code>bin/rails db:seed</code> or create one above.</p>
  <% end %>
  <ul class="ticket-list">
    <% @tickets.each do |ticket| %>
      <li class="ticket-row">
        <div class="ticket-main">
          <%= link_to ticket.subject, ticket, class: "ticket-subject" %>
          <span class="muted"><%= ticket.customer_email %></span>
        </div>
        <div class="badges">
          <span class="badge status-<%= ticket.status %>"><%= ticket.status %></span>
          <% if ticket.priority %><span class="badge priority-<%= ticket.priority %>"><%= ticket.priority %></span><% end %>
          <% if ticket.category %><span class="badge"><%= ticket.category %></span><% end %>
          <% if ticket.sentiment %><span class="badge sentiment-<%= ticket.sentiment %>"><%= ticket.sentiment %></span><% end %>
        </div>
        <% if ticket.triage_summary %>
          <p class="muted small"><%= ticket.triage_summary %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
