<% page_title "Check of #{@hunt.title}" %>
<div class="stack" <% if @run.in_progress? %>data-controller="poll" data-poll-interval-value="3000"<% end %>>
  <div class="page-head">
    <div>
      <p class="small"><%= link_to @hunt.title, @hunt, class: "muted" %></p>
      <h1>Check from <%= time_ago(@run.created_at) %></h1>
      <div class="row">
        <%= status_badge @run.status %>
        <span class="small dim"><%= @run.trigger == "scheduled" ? "Scheduled check" : "You asked for this check" %></span>
        <% if developer_details? %><%= trace_link @run.trace_id %><% end %>
      </div>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><span class="label">Listings looked at</span><div class="value"><%= @run.candidate_count %></div></div>
    <div class="stat"><span class="label">New finds</span><div class="value"><%= @run.new_findings_count %></div></div>
    <div class="stat"><span class="label">Took</span><div class="value"><%= duration_label @run.duration %></div></div>
    <div class="stat"><span class="label">Price</span><div class="value"><%= @run.fee_cents.zero? ? "Included" : money(@run.fee_cents) %></div></div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Summary</h3></div>
    <% if @run.summary.present? %>
      <div class="summary"><%= @run.summary %></div>
    <% else %>
      <p class="dim"><%= @run.in_progress? ? "We're checking now. This page updates on its own." : "No summary for this check." %></p>
    <% end %>
    <% if @run.failed? %>
      <p class="flags" style="margin-top: 0.75rem">This check didn't finish. Try again in a little while.</p>
    <% end %>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Finds from this check</h2></div>
    <% if @findings.empty? %>
      <p class="dim">Nothing new this time.</p>
    <% else %>
      <%= render "findings/collection", findings: @findings, view: "gallery" %>
    <% end %>
  </div>

  <% if developer_details? %>
    <details class="dev">
      <summary>Details for admins</summary>
      <p class="mono small">Provider <%= @run.provider %>/<%= @run.model %> | <%= @run.input_tokens %> in / <%= @run.output_tokens %> out | scored by <%= @run.scored_by || "n/a" %> | queries: <%= @run.query_list.join(" ; ") %><% if @run.error_message.present? %> | <%= @run.error_message %><% end %></p>
      <% @contexts.each do |context| %>
        <p class="small"><strong>Persisted conversation</strong> (solid_agent): <%= context.agent_name %>#<%= context.action_name %>, <%= context.messages.size %> messages, <%= context.generations.size %> generations, <%= context.total_tokens %> tokens</p>
        <div class="transcript">
          <% context.messages.order(:created_at).each do |message| %>
            <div class="turn">
              <span class="role"><%= message.role %></span>
              <div class="body"><%= message.content.to_s.truncate(3000) %></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </details>
  <% end %>
</div>
