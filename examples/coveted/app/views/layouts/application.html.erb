<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Coveted" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="application-name" content="Coveted">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="container topbar-inner">
        <%= link_to root_path, class: "wordmark" do %>
          <span class="mark">C</span> Coveted
        <% end %>

        <nav class="nav">
          <% if authenticated? %>
            <%= nav_link "My wants", hunts_path %>
            <%= link_to findings_path, class: "nav-link #{'is-active' if request.path.start_with?(findings_path)}" do %>
              Finds<% if (fresh = current_user.findings.fresh.count).positive? %><span class="count"><%= fresh %></span><% end %>
            <% end %>
            <%= nav_link "Plan", billing_path %>
            <% if current_user.admin? %>
              <a class="nav-link" href="/activeagents" data-turbo="false">Dashboard</a>
            <% end %>
          <% else %>
            <%= link_to "How it works", root_path(anchor: "how"), class: "nav-link" %>
            <%= link_to "Pricing", root_path(anchor: "pricing"), class: "nav-link" %>
          <% end %>
        </nav>

        <% if authenticated? %>
          <div class="user">
            <span><%= current_user.display_name %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-small btn-quiet" %>
          </div>
        <% else %>
          <div class="actions">
            <%= link_to "Sign in", new_session_path, class: "btn btn-small" %>
            <%= link_to "Start hunting", new_registration_path, class: "btn btn-small btn-primary" %>
          </div>
        <% end %>
      </div>
    </header>

    <main class="container">
      <% if notice %><div class="flash notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>

    <footer class="container footer">
      Coveted finds rare things for collectors. Built on <a class="link" href="https://activeagents.ai">Active Agent</a>.
    </footer>
  </body>
</html>
